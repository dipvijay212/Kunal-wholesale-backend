PORT=5000
NODE_ENV=development

DB_DIALECT=mysql
DB_STORAGE=./database.sqlite

# MySQL Settings (if DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kunal-saree
DB_USER=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=kunal_sarees_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Initial Seed Admin Credentials
ADMIN_NAME=Kunal Sarees Admin
ADMIN_EMAIL=admin@kunalsarees.com
ADMIN_PASSWORD=Admin@123

ENABLE_PUBLIC_REGISTRATION=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=kunal-sarees/products

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Kunal Sarees <onboarding@resend.dev>

