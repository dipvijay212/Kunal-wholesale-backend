PORT=5000
NODE_ENV=development

# Database Dialect: 'postgres' (for Neon), 'mysql', or 'sqlite'
DB_DIALECT=postgres

# Neon / PostgreSQL Configuration (Recommended: Full Connection String)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternatively, individual PostgreSQL / MySQL variables:
# DB_HOST=ep-cool-fog-123456.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your_password
# DB_SSL=true

# SQLite fallback:
# DB_STORAGE=./database.sqlite

JWT_SECRET=kunal_sarees_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Initial Seed Admin Credentials
ADMIN_NAME=Kunal Sarees Admin
ADMIN_EMAIL=admin@kunalsarees.com
ADMIN_PASSWORD=Admin@123

# Registration Security Flag
ENABLE_PUBLIC_REGISTRATION=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=kunal-sarees/products

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Kunal Sarees <onboarding@resend.dev>

# SMTP Configuration (Optional)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
